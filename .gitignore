# ---------------------------------------------------------------------------
# Retired Java version
# ---------------------------------------------------------------------------
# The Java prototype is no longer part of this project. It is kept out of the
# tree entirely; C++ is the only version.
recipe_suggestor_java/
models_training/java_compatibility_test/
.github/java-upgrade/

# ---------------------------------------------------------------------------
# Models and datasets
# ---------------------------------------------------------------------------
# Trained weights are ~12 MB each and are reproducible from models_training/.
# They are never committed; see recipe_suggestor/README.md "Getting the models".
*.onnx
*.pt
*.pth
recipe_suggestor/resources/models/

# Roboflow dataset exports: re-downloadable, tens of MB
models_training/pickups---TBOI-*/
models_training/BoC---TBOI*/
models_training/runs/
models_training/lib/
models_training/outputs/
models_training/test_images/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
recipe_suggestor/build/
recipe_suggestor/outputs/
recipe_suggestor/lib/
recipe_suggestor/crafts_run*/
build/
dist/
test_cpp

# Dataset crops stay out, but git cannot look inside an excluded directory, so
# exclude the contents and re-include the screens/ the live-path tests assert on
recipe_suggestor/resources/test_images/*
!recipe_suggestor/resources/test_images/screens/

